{
  "manifest_version": 3,
  "name": "Inbox Only",
  "version": "2.0.0",
  "description": "Locks Instagram, Facebook and any site you choose to their messaging pages. Facebook Marketplace stays open.",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.facebook.com/*",
    "*://facebook.com/*",
    "*://*.messenger.com/*",
    "*://messenger.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
